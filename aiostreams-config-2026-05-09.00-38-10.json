    "multiGroupBehaviour": "aggressive",
    "cached": "single_result",
    "uncached": "per_service",
    "p2p": "single_result",
    "http": "disabled",
    "live": "disabled",
    "youtube": "disabled",
    "external": "disabled",
    "smartDetectAttributes": [
